{
    "name": "@tinycld/calc",
    "version": "0.2.2",
    "private": true,
    "type": "module",
    "description": "Collaborative spreadsheets for your server",
    "exports": {
        "./package.json": "./package.json",
        "./manifest": "./manifest.ts",
        "./types": "./tinycld/calc/types.ts",
        "./collections": "./tinycld/calc/collections.ts",
        "./automation": "./tinycld/calc/automation.ts",
        "./screens/*": "./tinycld/calc/screens/*.tsx",
        "./seed": "./tinycld/calc/seed.ts",
        "./provider": "./tinycld/calc/provider.tsx",
        "./hooks/*": "./tinycld/calc/hooks/*.ts",
        "./components/*": "./tinycld/calc/components/*.tsx"
    },
    "scripts": {
        "typecheck": "tinycld-pkg typecheck",
        "test": "tinycld-pkg test",
        "test:e2e": "tinycld-pkg test:e2e",
        "check": "tinycld-pkg check"
    },
    "devDependencies": {
        "@tinycld/package-scripts": "*"
    },
    "peerDependencies": {
        "@tinycld/drive": ">=0.2.0 <0.3.0",
        "expo-print": "^55.0.14",
        "expo-sharing": "~55.0.18",
        "hyperformula": ">=3.0.0",
        "numfmt": ">=3.2"
    }
}
